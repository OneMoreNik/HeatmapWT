diff --git a/wrpl/wrplRead.go b/wrpl/wrplRead.go
index 852169f..36b2dc6 100644
--- a/wrpl/wrplRead.go
+++ b/wrpl/wrplRead.go
@@ -28,8 +28,53 @@ import (
 	"slices"
 
 	"github.com/klauspost/compress/zlib"
+	"github.com/klauspost/compress/zstd"
 )
 
+// zstdMagic is the Zstandard frame magic.  Replays recorded by game version
+// 101404 (October 2026) compress the packet stream with zstd; older ones used
+// zlib, so both are accepted.
+var zstdMagic = []byte{0x28, 0xb5, 0x2f, 0xfd}
+
+// zstdReadCloser adapts a zstd decoder to io.ReadCloser.
+type zstdReadCloser struct {
+	io.Reader
+	dec *zstd.Decoder
+}
+
+func (z *zstdReadCloser) Close() error {
+	z.dec.Close()
+	return nil
+}
+
+// openPacketStream decompresses the packet stream at the current offset,
+// picking the codec from the frame magic.
+func openPacketStream(r io.ReadSeeker) (io.ReadCloser, error) {
+	at, err := r.Seek(0, io.SeekCurrent)
+	if err != nil {
+		return nil, err
+	}
+	var magic [4]byte
+	if _, err := io.ReadFull(r, magic[:]); err != nil {
+		return nil, fmt.Errorf("reading compression magic: %w", err)
+	}
+	if _, err := r.Seek(at, io.SeekStart); err != nil {
+		return nil, err
+	}
+	if bytes.Equal(magic[:], zstdMagic) {
+		dec, err := zstd.NewReader(r)
+		if err != nil {
+			return nil, fmt.Errorf("opening zstd packets stream: %w", err)
+		}
+		return &zstdReadCloser{Reader: dec.IOReadCloser(), dec: dec}, nil
+	}
+	rc, err := zlib.NewReader(r)
+	if err != nil {
+		return nil, fmt.Errorf("opening zlib packets stream: %w", err)
+	}
+	return rc, nil
+}
+
